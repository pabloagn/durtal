# =============================================================================
# Durtal — Environment Variables
# =============================================================================
# Copy to .env.local (Next.js) and .env (Python scripts).
# src/lib/env.ts validates these at server startup.
# See docs/13_CONFIGURATION.md for each variable.

# Database (Neon), required
# Get from: Neon Dashboard → Connection String
DATABASE_URL=postgresql://neondb_owner:xxxxx@ep-xxxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# AWS S3. Keys required; region and bucket have defaults
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=eu-north-1
S3_BUCKET=durtal

# eBook files: existing private durtal bucket, layer-first ebook prefixes (SLN-569).
# EBOOKS_PREFIX is only for legacy files/derived/staging keys; new keys are
# bronze/ebooks, silver/ebooks and gold/ebooks. Region defaults to AWS_REGION.
EBOOKS_BUCKET=durtal with EBOOKS_PREFIX=ebooks/ keeps them in durtal),
# and its region (default AWS_REGION).
EBOOKS_BUCKET=
EBOOKS_PREFIX=
EBOOKS_REGION=
# How files reach the browser: app (default; the app streams them by byte
# range) or cloudfront (signed URLs; needs the three EBOOK_CDN_ variables,
# configured by the separate SLN-491 private CDN rollout).
EBOOK_DELIVERY=
EBOOK_CDN_URL=
EBOOK_CDN_KEY_PAIR_ID=
# The key group's private key, a PEM encoded as base64. Only in .env, never committed.
EBOOK_CDN_PRIVATE_KEY=

# External APIs, optional. Each feature is off without its key.
# Google Books: https://console.cloud.google.com/apis/credentials
# Without a key, anonymous requests hit the shared rate limit (HTTP 429).
GOOGLE_BOOKS_API_KEY=
# Google Places (venue search): same console, Places API (New) enabled
GOOGLE_PLACES_API_KEY=
# ISBNdb: https://isbndb.com/isbn-database (ISBNDN_API_KEY still accepted)
ISBNDB_API_KEY=
# Mapbox (authors map), public token: https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=

# Book enrichment
# The contact in the enrichment User-Agent: "DurtalBot/1.0 (personal book
# catalogue; <contact>)". Unset = the evidence fetcher refuses to start.
ENRICHMENT_CONTACT=you@example.com
# Monthly cap of metered enrichment calls, in US dollars. 0 = free-tier calls
# only; unset = every metered call stops.
ENRICHMENT_MONTHLY_CAP_USD=
# The research agent's main search: Tavily, https://app.tavily.com (free plan,
# 1,000 credits a month). Unset = research refuses to apply.
TAVILY_API_KEY=
# Its fallback: Brave Search API, https://brave.com/search/api/ ($5 per 1,000
# requests). Unset = no fallback, and the run report says so.
BRAVE_SEARCH_API_KEY=
# The research agent's extraction model, claude-opus-5-5:
# https://console.anthropic.com. Unset = extraction refuses to apply.
ANTHROPIC_API_KEY=

# Application
NODE_ENV=development
# REST API write access (orders, copies, works). Unset = writes refused.
# Generate with: openssl rand -hex 32
DURTAL_API_TOKEN=
# Time zone for server-side "today" (default: Europe/Amsterdam)
APP_TIMEZONE=Europe/Amsterdam
# Media maintenance routes (reprocess, apply-crops, backfill-palettes), sent as
# the x-admin-token header. Unset = these routes refused.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Python scripts
# Path to knowledge_base.xlsx (for seed data import)
INGEST_EXCEL_PATH=/home/pabloagn/dev/phantom/src/packages/phantom-canon/data/knowledge_base.xlsx
# API base URL for the TUI client. Optional, default shown
# DURTAL_API_URL=http://localhost:3003

# Required by non-preview eBook CLI only. Set the reviewed personal account ID.
# EBOOKS_AWS_ACCOUNT_ID=111122223333
