# =============================================================================
# Durtal — Environment Variables
# =============================================================================
# Copy to .env.local (Next.js) and .env (Python scripts).
# src/lib/env.ts validates these at server startup.
# See docs/13_CONFIGURATION.md for each variable.

# Database (Neon), required
# Get from: Neon Dashboard → Connection String
DATABASE_URL=postgresql://neondb_owner:xxxxx@ep-xxxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# AWS S3. Keys required; region and bucket have defaults
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=eu-central-1
S3_BUCKET=durtal

# External APIs, optional. Each feature is off without its key.
# Google Books: https://console.cloud.google.com/apis/credentials
# Without a key, anonymous requests hit the shared rate limit (HTTP 429).
GOOGLE_BOOKS_API_KEY=
# Google Places (venue search): same console, Places API (New) enabled
GOOGLE_PLACES_API_KEY=
# ISBNdb: https://isbndb.com/isbn-database (ISBNDN_API_KEY still accepted)
ISBNDB_API_KEY=
# Mapbox (authors map), public token: https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=

# Application
NODE_ENV=development
# REST API write access (orders, copies, works). Unset = writes refused.
# Generate with: openssl rand -hex 32
DURTAL_API_TOKEN=
# Admin bulk media endpoints (x-admin-token header). Set it: while unset,
# these endpoints skip the check (SLN-423 makes them refuse instead).
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Python scripts
# Path to knowledge_base.xlsx (for seed data import)
INGEST_EXCEL_PATH=/home/pabloagn/dev/phantom/src/packages/phantom-canon/data/knowledge_base.xlsx
# Calibre library root for scripts/calibre_sync. Optional, default shown
# CALIBRE_LIBRARY_PATH=/mnt/data/Books-Library
# API base URL for the TUI client. Optional, default shown
# DURTAL_API_URL=http://localhost:3003
