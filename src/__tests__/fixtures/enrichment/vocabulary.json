              "title": "Malina",
              "author": "Ingeborg Bachmann"
            }
          ]
        },
        {
          "key": "gothic",
          "label": "Gothic",
          "definition": "Dark with decay, ruins and dread.",
          "appliesWhen": "The book is gothic throughout, by the reviews' own words.",
          "doesNotApplyWhen": "Only one scene is gothic.",
          "examples": [
            {
              "title": "Nadja",
              "author": "André Breton"
            },
            {
              "title": "Là-bas",
              "author": "J.-K. Huysmans"
            },
            {
              "title": "Malina",
              "author": "Ingeborg Bachmann"
            }
          ],
          "parent": "dark"
        }
      ]
    },
    {
      "key": "pace",
      "label": "Pace",
      "definition": "How fast the story moves.",
      "layer": "experience",
      "valueKind": "scale",
      "applyTarget": "taxonomy",
      "family": "attributes",
      "attributeCategory": "pace",
      "parameters": {
        "easierEnd": "high"
      },
      "terms": [
        {
          "key": "slow",
          "label": "Slow",
          "definition": "Long stretches with little happening.",
          "appliesWhen": "The book is slow throughout, by the reviews' own words.",
          "doesNotApplyWhen": "Only one scene is slow.",
          "examples": [
            {
              "title": "Nadja",
              "author": "André Breton"
            }
          ],
          "scaleValue": 1
        },
        {
          "key": "steady",
          "label": "Steady",
          "definition": "Even, unhurried movement.",
          "appliesWhen": "The book is steady throughout, by the reviews' own words.",
          "doesNotApplyWhen": "Only one scene is steady.",
          "examples": [
            {
              "title": "Là-bas",
              "author": "J.-K. Huysmans"
            }
          ],
          "scaleValue": 2
        },
        {
          "key": "fast",
          "label": "Fast",
          "definition": "Events press on one another.",
