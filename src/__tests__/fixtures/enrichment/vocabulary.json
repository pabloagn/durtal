{
  "version": 1,
  "documentUrl": "https://docs.example.org/book-enrichment-vocabulary-fixture",
  "notes": "A small fixture vocabulary for the tests (SLN-462); never loaded on live.",
  "dimensions": [
    {
      "key": "tone",
      "label": "Tone",
      "definition": "The feeling the prose leaves.",
      "layer": "experience",
      "valueKind": "terms",
      "applyTarget": "taxonomy",
      "family": "themes",
      "requiresIndependentSources": true,
      "autoAcceptEligible": true,
      "parameters": {
        "exclusiveTerms": [
          [
            "dark",
            "light"
          ]
        ]
      },
      "rule": {
        "basis": "evaluation_gate",
        "minimumConfidence": 0.9,
        "minimumSample": 50
      },
      "terms": [
        {
          "key": "dark",
          "label": "Dark",
          "definition": "Bleak, heavy, hopeless.",
          "appliesWhen": "The book is dark throughout, by the reviews' own words.",
          "doesNotApplyWhen": "Only one scene is dark.",
          "examples": [
            {
              "workId": "7c2f1d52-1b8e-4c5a-9d3e-2f6a8b1c4e90",
              "slug": "the-fixture-book"
            },
            {
              "title": "Nadja",
              "author": "André Breton"
            },
            {
              "title": "Là-bas",
              "author": "J.-K. Huysmans"
            }
          ]
        },
        {
          "key": "light",
          "label": "Light",
          "definition": "Warm and buoyant.",
          "appliesWhen": "The book is light throughout, by the reviews' own words.",
          "doesNotApplyWhen": "Only one scene is light.",
          "examples": [
            {
              "title": "Nadja",
              "author": "André Breton"
            },
            {
              "title": "Là-bas",
              "author": "J.-K. Huysmans"
