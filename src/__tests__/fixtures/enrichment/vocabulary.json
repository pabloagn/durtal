    },
    {
      "key": "setting",
      "label": "Setting",
      "definition": "Where the story takes place.",
      "layer": "facts",
      "valueKind": "place",
      "applyTarget": "values",
      "parameters": {
        "research": true
      }
    },
    {
      "key": "composition_year",
      "label": "Composition year",
      "definition": "The year the author finished it.",
      "layer": "facts",
      "valueKind": "number",
      "applyTarget": "values"
    },
    {
      "key": "original_title",
      "label": "Original title",
      "definition": "The title in the original language.",
      "layer": "facts",
      "valueKind": "text",
      "applyTarget": "work.original_title"
    },
    {
      "key": "wikidata",
      "label": "Wikidata",
      "definition": "The book's Wikidata item.",
      "layer": "identity",
      "valueKind": "identifier",
      "provider": "wikidata",
      "applyTarget": "identifier",
      "autoAcceptEligible": true,
      "rule": {
        "basis": "exact_identifier_match",
        "minimumConfidence": 1
      }
    },
    {
      "key": "translator",
      "label": "Translator",
      "definition": "Who translated the edition.",
      "layer": "facts",
      "valueKind": "person",
      "entityLevel": "edition",
      "applyTarget": "edition.translator"
    },
    {
      "key": "readers",
      "label": "Readers",
      "definition": "How many people log the book each month.",
      "layer": "popularity",
      "valueKind": "number",
      "applyTarget": "none",
      "unknownHandling": "include_as_unknown",
      "parameters": {
        "bands": [
          {
            "key": "obscure",
            "label": "Obscure",
            "fromPercentile": 0,
            "toPercentile": 25
          },
          {
            "key": "known",
            "label": "Known",
            "fromPercentile": 25,
            "toPercentile": 75
          },
          {
