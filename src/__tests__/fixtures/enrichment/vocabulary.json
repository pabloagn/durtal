            {
              "title": "Nadja",
              "author": "André Breton"
            },
            {
              "title": "Là-bas",
              "author": "J.-K. Huysmans"
            },
            {
              "title": "Malina",
              "author": "Ingeborg Bachmann"
            }
          ]
        }
