{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EbooksMultipartRecovery",
      "Effect": "Allow",
      "Action": ["s3:ListMultipartUploadParts", "s3:AbortMultipartUpload"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/bronze/ebooks/*",
        "arn:aws:s3:::__BUCKET__/silver/ebooks/*",
        "arn:aws:s3:::__BUCKET__/gold/ebooks/*"
      ]
    }
  ]
}
