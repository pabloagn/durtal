{
  "Name": "durtal-ebooks-cors",
  "Comment": "Bearer signed URLs; no cookies; exact byte-range response headers",
  "CorsConfig": {
    "AccessControlAllowOrigins": {
      "Quantity": 1,
      "Items": [
        "*"
      ]
    },
    "AccessControlAllowHeaders": {
      "Quantity": 1,
      "Items": [
        "Range"
      ]
    },
    "AccessControlAllowMethods": {
      "Quantity": 3,
      "Items": [
        "GET",
        "HEAD",
        "OPTIONS"
      ]
    },
    "AccessControlAllowCredentials": false,
    "AccessControlExposeHeaders": {
      "Quantity": 4,
      "Items": [
        "Content-Range",
        "Accept-Ranges",
        "Content-Length",
        "ETag"
      ]
    },
    "AccessControlMaxAgeSec": 86400,
    "OriginOverride": true
  },
  "SecurityHeadersConfig": {
    "ContentTypeOptions": {
      "Override": true
    }
  }
}
