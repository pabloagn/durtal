{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EbooksDenyDeletionExceptAdmin",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/bronze/ebooks/*",
        "arn:aws:s3:::__BUCKET__/silver/ebooks/*",
        "arn:aws:s3:::__BUCKET__/gold/ebooks/*",
        "arn:aws:s3:::__BUCKET__/__PREFIX__files/*",
        "arn:aws:s3:::__BUCKET__/__PREFIX__derived/*"
      ],
      "Condition": {
        "ArnNotEquals": {
          "aws:PrincipalArn": "__ADMIN_ARN__"
        }
      }
    },
    {
      "Sid": "EbooksRequireConditionalCreation",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::__BUCKET__/bronze/ebooks/*",
        "arn:aws:s3:::__BUCKET__/silver/ebooks/*",
        "arn:aws:s3:::__BUCKET__/gold/ebooks/*"
      ],
      "Condition": {
        "Null": {
          "s3:if-none-match": "true"
        },
        "Bool": {
          "s3:ObjectCreationOperation": "true"
        }
      }
    }
  ]
}
